# Copie este arquivo para .env e preencha com os SEUS dados.
# O .env guarda seus segredos e NUNCA deve ser compartilhado nem enviado ao GitHub.

# ── Telegram ─────────────────────────────────────────────────────────
# Token do bot, criado no @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Canal/grupo onde as ofertas serão postadas.
# Canal público: @nomedocanal | Canal/grupo privado: id numérico (ex: -1001234567890)
# Dica: rode o bot, encaminhe um post do canal para o bot no privado e ele mostra o id.
TELEGRAM_CHAT_ID=

# Seu user id do Telegram (mande /id para o bot no privado).
# Só esse usuário pode mandar links para converter/postar.
TELEGRAM_OWNER_ID=

# ── Mercado Livre ────────────────────────────────────────────────────
# A "Etiqueta em uso" que aparece no Linkbuilder do painel de afiliados
# (https://www.mercadolivre.com.br/afiliados/linkbuilder)
ML_ETIQUETA=

# ── Amazon ───────────────────────────────────────────────────────────
# Sua tag/Store ID do Amazon Associates (ex: seunome-20)
AMAZON_TAG=
# Creators API (opcional): Associates Central > Ferramentas > Creators API > Aplicativos
# Sem isso o bot ainda funciona com scraping + link com tag; a busca oficial precisa das credenciais.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=

# ── Shopee ───────────────────────────────────────────────────────────
# Painel de afiliados Shopee > menu "Abrir API" (solicite acesso se ainda não tiver)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# ── AliExpress (Opcional) ───────────────────────────────────────────
# Código do seu link de afiliado do AliExpress Portals (tracking ID / sk)
ALIEXPRESS_TRACKING_ID=

# ── Magazine Luiza / Magazine Você (Opcional) ────────────────────────
# O nome da sua vitrine de afiliado no Magazine Você (ex: sualoja)
MAGALU_LOJA=

# ── Múltiplos Canais Telegram (Opcional) ─────────────────────────────
# Canais/grupos extras separados por vírgula (ex: @canal2, -1001234567890)
TELEGRAM_CANAIS_EXTRAS=

# ── Inteligência Artificial - Google Gemini (Opcional) ───────────────
# Chave gratuita do Google AI Studio (https://aistudio.google.com/)
# Limpa títulos poluídos de marketplaces e extrai 3 destaques técnicos
GEMINI_API_KEY=

# ── WhatsApp Cross-Posting (Opcional) ────────────────────────────────
# URL base e chave da Evolution API, Z-API ou compatível
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=ofertas
# Números ou IDs de grupos/canais separados por vírgula (ex: 1203630...@g.us)
WHATSAPP_CHATS=

